{
  "name": "commburn",
  "version": "0.1.2",
  "description": "Metric-first vector editor for laser jobs",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "start": "node server.mjs",
    "desktop": "electron .",
    "dist": "electron-builder --publish never",
    "dist:msix": "electron-builder --win appx --publish never --config electron-builder.msix.cjs && node scripts/rename-msix.mjs"
  },
  "dependencies": {
    "@jodit/image-editor": "^0.2.5",
    "imagetracerjs": "^1.2.6",
    "opentype.js": "^2.0.0",
    "serialport": "^13.0.0",
    "svg-pathdata": "^6.0.3",
    "svgson": "^5.3.1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "main": "electron-main.mjs",
  "desktopName": "CommBurn",
  "build": {
    "appId": "org.commburn.editor",
    "productName": "CommBurn",
    "icon": "build/icon.png",
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "electron-main.mjs",
      "server.mjs",
      "index.html",
      "commburn-icon.svg",
      "LICENSE",
      "LICENSE-PLUGINS",
      "src/**/*",
      "!tests/**",
      "!docs/**",
      "!cli/**"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "LICENSE-PLUGINS",
        "to": "LICENSE-PLUGINS"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "license": "LICENSE"
    },
    "win": {
      "target": [
        "msi",
        "portable"
      ]
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "appx": {
      "identityName": "CMBRN-Software.CommBurn",
      "applicationId": "CommBurn",
      "publisher": "CN=7388B7C3-5297-4CC5-82D1-023AC104A00B",
      "publisherDisplayName": "CMBRN - Software",
      "displayName": "CommBurn",
      "minVersion": "10.0.19041.0"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "maintainer": "Mauricio-MN <81537317+Mauricio-MN@users.noreply.github.com>",
      "syncDesktopName": true
    }
  }
}
